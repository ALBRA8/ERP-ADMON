# Marsella ERP — Variables de entorno
# Copia este archivo a .env y completa los secretos.
# NUNCA subas tu .env real al repositorio.

# Base de datos (SQLite para preview; cambia a PostgreSQL en producción)
# Para PostgreSQL: postgresql://user:password@localhost:5432/marsella_erp
DATABASE_URL=file:./db/custom.db

# Secreto para firmar JWT (mínimo 32 caracteres)
# Genera con: openssl rand -base64 32
APP_SECRET=

# Clave AES-256-GCM (64 hex chars = 32 bytes) para cifrar credenciales por organización
# Genera con: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Token para el servidor MCP (compartido con clientes externos)
# Genera con: openssl rand -hex 32
MCP_API_TOKEN=

# Secreto para cron jobs (header X-Cron-Secret)
# Genera con: openssl rand -hex 32
CRON_SECRET=

# Secreto de super-admin (para upgrades de plan a enterprise)
# Genera con: openssl rand -hex 32
SUPER_ADMIN_SECRET=

# Habilitar endpoint /api/auth/demo en producción (NO recomendado)
ENABLE_DEMO_ENDPOINT=false
