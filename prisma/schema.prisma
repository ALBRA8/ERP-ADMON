// ============================================================
// MARSELLA ERP — Prisma Schema
// Núcleo contable-administrativo inspirado en SG Hermes 9.2.1.1,
// rediseñado sobre Next.js 16 + TypeScript + SQLite (intercambiable
// a PostgreSQL cambiando el provider). Multi-tenant por Empresa,
// audit-hardened, con FK formales (deuda técnica de Hermes resuelta).
// Mapeo Hermes → Marsella documentado en docs/MIGRATION_FROM_HERMES.md
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Multi-tenancy: Empresa ----------

model Empresa {
  id                 String   @id @default(cuid())
  nit                String   @unique // 900.123.456-7
  razonSocial        String
  nombreComercial    String?
  direccion          String?
  telefono           String?
  ciudad             String?
  email              String?
  website            String?
  representanteLegal String?
  regimenTributario  String   @default("comun") // simple | comun | gran_contribuyente
  responsabilidad    String   @default("iva") // iva | no_responsable
  logo               String? // URL/base64
  moneda             String   @default("COP")
  decimales          Int      @default(2)
  redondeo           String   @default("half_up") // half_up | half_even | down
  zonaHoraria        String   @default("America/Bogota")
  // PUC maestro
  planCuentas        String   @default("Colombia_PUC")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  resolucionDian        ResolucionDian[]
  terceros              Tercero[]
  productos             Producto[]
  servicios             Servicio[]
  bodegas               Bodega[]
  unidadesMedida        UnidadMedida[]
  lineas                LineaClasificacion[]
  listasPrecio          ListaPrecio[]
  impuestos             Impuesto[]
  centrosCosto          CentroCosto[]
  cuentasPuc            CuentaPuc[]
  comprobantes          Comprobante[] // asientos contables
  movimientosCont       MovimientoContable[]
  facturasVenta         FacturaVenta[]
  facturasCompra        FacturaCompra[]
  recibosCaja           ReciboCaja[]
  comprobantesEgreso    ComprobanteEgreso[]
  notas                 Nota[]
  usuarios              Usuario[]
  parametros            Parametro[]
  tiposDocumento        TipoDocumento[]
  ciudades              Ciudad[]
  actividadesEconomicas ActividadEconomica[]
}

// ---------- Seguridad / RBAC (Hermes §5.1 mejorado) ----------

model Usuario {
  id            String    @id @default(cuid())
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  email         String    @unique
  nombre        String
  passwordHash  String // bcryptjs
  rol           String    @default("vendedor") // admin | contador | cajero | vendedor | bodeguero
  activo        Boolean   @default(true)
  telefono      String?
  cargo         String?
  ultimoLogin   DateTime?
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([empresaId])
}

model Parametro {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clave       String
  valor       String // JSON scalar
  descripcion String?
  updatedAt   DateTime @updatedAt

  @@unique([empresaId, clave])
  @@index([empresaId])
}

// ---------- Catálogos maestros (Hermes §5.2) ----------

model Ciudad {
  id           String    @id @default(cuid())
  empresaId    String
  empresa      Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigoDane   String    @unique
  nombre       String
  departamento String
  createdAt    DateTime  @default(now())
  terceros     Tercero[]

  @@index([empresaId])
}

model ActividadEconomica {
  id          String    @id @default(cuid())
  empresaId   String
  empresa     Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigoCIIU  String
  descripcion String
  tarifaICA   Float     @default(0) // por mil
  createdAt   DateTime  @default(now())
  terceros    Tercero[]

  @@unique([empresaId, codigoCIIU])
}

model TipoDocumento {
  id                   String         @id @default(cuid())
  empresaId            String
  empresa              Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo               String // FAC | FPOS | COM | RC | CE | NDV | NCV | NDC | NCC
  nombre               String // Factura de Venta, Factura POS, Compra...
  naturaleza           String // debito | credito (para tercero y contable)
  afectaCartera        String         @default("none") // cxc | cxp | none
  afectaInventario     String         @default("none") // entrada | salida | none
  afectaContabilidad   Boolean        @default(true)
  consecutivoSiguiente Int            @default(1)
  createdAt            DateTime       @default(now())
  facturaVentas        FacturaVenta[]

  @@unique([empresaId, codigo])
}

// Resolución DIAN (Hermes §5.3) — soporta facturación electrónica
model ResolucionDian {
  id                   String   @id @default(cuid())
  empresaId            String
  empresa              Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numeroResolucion     String
  fechaResolucion      DateTime
  fechaInicioVigencia  DateTime
  fechaFinVigencia     DateTime
  prefijo              String // FEL, FPOS, FEST
  rangoinicio          Int
  rangoFin             Int
  rangoinicioActual    Int
  rangoFinActual       Int
  consecutivoSiguiente Int      @default(1) // # próximo
  tipoOperacion        String   @default("estandar") // estandar | pos | exportacion | no_dian
  ambiente             String   @default("produccion") // pruebas | produccion
  activa               Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@index([empresaId, activa])
}

model Impuesto {
  id               String     @id @default(cuid())
  empresaId        String
  empresa          Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo           String // 01 | 04 | 06 | 07 (DIAN)
  nombre           String // IVA 19% | IVA 5% | Excento | Impoconsumo
  tipo             String // iva | impoconsumo | retefuente | reteica | reteiva
  tarifa           Float // 19, 5, 0, 2.5, etc
  cuentaContableId String?
  activo           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  productos        Producto[]

  @@unique([empresaId, codigo])
}

model CentroCosto {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo    String
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([empresaId, codigo])
}

model UnidadMedida {
  id        String     @id @default(cuid())
  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo    String     @unique // UND, KG, LT, MTR, CJA
  nombre    String
  factor    Float      @default(1) // para conversions
  createdAt DateTime   @default(now())
  productos Producto[]

  @@index([empresaId])
}

// Clasificación 6 niveles (Hermes §5.2 - linea1..linea6 colapsado a árbol)
model LineaClasificacion {
  id        String               @id @default(cuid())
  empresaId String
  empresa   Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    LineaClasificacion?  @relation("LineaTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  LineaClasificacion[] @relation("LineaTree")
  nivel     Int // 1..6
  codigo    String
  nombre    String
  createdAt DateTime             @default(now())
  productos Producto[]

  @@unique([empresaId, codigo, nivel])
  @@index([empresaId, parentId])
}

model ListaPrecio {
  id              String           @id @default(cuid())
  empresaId       String
  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre          String // Mayorista, Detal, VIP
  margen          Float            @default(0) // % sobre costo
  activa          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  precioProductos PrecioProducto[]

  @@index([empresaId])
}

// ---------- Terceros (Hermes §5.2) ----------

model Tercero {
  id                   String              @id @default(cuid())
  empresaId            String
  empresa              Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo                 String // cliente | proveedor | empleado | socio | todos
  tipoDocumento        String              @default("CC") // CC | NIT | CE | TI | PT
  numeroDocumento      String
  digitoVerif          String?
  nombre               String // razón social o nombre completo
  apellido1            String?
  apellido2            String?
  nombreComercial      String?
  direccion            String?
  telefono             String?
  email                String?
  ciudadId             String?
  ciudad               Ciudad?             @relation(fields: [ciudadId], references: [id])
  departamento         String?
  pais                 String              @default("CO")
  regimenTributario    String              @default("comun")
  responsabilidad      String              @default("iva")
  actividadEconomicaId String?
  actividadEconomica   ActividadEconomica? @relation(fields: [actividadEconomicaId], references: [id])
  // Crédito
  cupoCredito          Float               @default(0)
  saldoCartera         Float               @default(0) // actualizado por triggers de factura/recibo
  diasPlazo            Int                 @default(0)
  // Empleado
  cargo                String?
  salario              Float?
  fechaIngreso         DateTime?
  epsId                String?
  arl                  String?
  afpId                String?
  // Auditoría
  activo               Boolean             @default(true)
  observaciones        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // Relaciones
  facturasVenta      FacturaVenta[]
  facturasCompra     FacturaCompra[]
  recibosCaja        ReciboCaja[]
  comprobantesEgreso ComprobanteEgreso[]
  notas              Nota[]
  movimientosCont    MovimientoContable[]
  creditos           Credito[]

  @@unique([empresaId, tipoDocumento, numeroDocumento])
  @@index([empresaId, tipo])
  @@index([empresaId, numeroDocumento])
}

// ---------- Productos / Inventario (Hermes §5.2 + §5.6) ----------

model Producto {
  id             String              @id @default(cuid())
  empresaId      String
  empresa        Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo         String // SKU interno
  codigoBarras   String?
  nombre         String
  descripcion    String?
  tipo           String              @default("producto") // producto | servicio | kit | insumo
  inventariable  Boolean             @default(true)
  unidadMedidaId String?
  unidadMedida   UnidadMedida?       @relation(fields: [unidadMedidaId], references: [id])
  lineaId        String?
  linea          LineaClasificacion? @relation(fields: [lineaId], references: [id])
  // Costos y precios
  costoPromedio  Float               @default(0)
  ultimoCosto    Float               @default(0)
  precio1        Float               @default(0) // precio base
  precio2        Float               @default(0)
  precio3        Float               @default(0)
  // Impuestos
  impuestoId     String?
  impuesto       Impuesto?           @relation(fields: [impuestoId], references: [id])
  tarifaIva      Float               @default(19) // snapshot
  // Inventario
  stockMinimo    Float               @default(0)
  stockMaximo    Float               @default(0)
  manejaLotes    Boolean             @default(false)
  manejaSeriales Boolean             @default(false)
  activo         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  detallesVenta    DetalleFacturaVenta[]
  detallesCompra   DetalleFacturaCompra[]
  movimientosInv   MovimientoInventario[]
  saldosInventario SaldoInventario[]
  preciosPorLista  PrecioProducto[]
  loteInventarios  LoteInventario[]

  @@unique([empresaId, codigo])
  @@index([empresaId, codigoBarras])
}

model Servicio {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo      String
  nombre      String
  descripcion String?
  precio      Float    @default(0)
  tarifaIva   Float    @default(19)
  duracion    Int? // minutos
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([empresaId, codigo])
}

model PrecioProducto {
  id            String      @id @default(cuid())
  productoId    String
  producto      Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  listaPrecioId String
  listaPrecio   ListaPrecio @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)
  precio        Float
  updatedAt     DateTime    @updatedAt

  @@unique([productoId, listaPrecioId])
}

// ---------- Bodegas e Inventario ----------

model Bodega {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo        String
  nombre        String
  direccion     String?
  responsableId String?
  activa        Boolean  @default(true)
  createdAt     DateTime @default(now())

  saldosInventario SaldoInventario[]
  movimientosInv   MovimientoInventario[]

  @@unique([empresaId, codigo])
}

// Saldo consolidado por bodega + producto
model SaldoInventario {
  id            String   @id @default(cuid())
  empresaId     String
  productoId    String
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  bodegaId      String
  bodega        Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  cantidad      Float    @default(0)
  costoTotal    Float    @default(0)
  costoPromedio Float    @default(0) // = costoTotal / cantidad
  stockMinimo   Float    @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([productoId, bodegaId])
  @@index([bodegaId])
}

// Lotes y seriales (Hermes §5.6)
model LoteInventario {
  id               String    @id @default(cuid())
  empresaId        String
  productoId       String
  producto         Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  bodegaId         String
  codigoLote       String
  fechaFabricacion DateTime?
  fechaVencimiento DateTime?
  cantidad         Float     @default(0)
  createdAt        DateTime  @default(now())

  @@unique([empresaId, productoId, codigoLote])
}

// Kardex (movimientos de inventario valorizados)
model MovimientoInventario {
  id            String   @id @default(cuid())
  empresaId     String
  productoId    String
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  bodegaId      String
  bodega        Bodega   @relation(fields: [bodegaId], references: [id])
  tipo          String // entrada | salida | traslado | ajuste
  cantidad      Float // + entrada, - salida
  costoUnitario Float
  costoTotal    Float
  documentoTipo String? // FAC_VENTA, COMPRA, AJUSTE...
  documentoId   String?
  loteId        String?
  fecha         DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([productoId, bodegaId, fecha])
  @@index([empresaId, fecha])
}

// ---------- Facturación de Venta (Hermes §5.3 mejorado) ----------

model FacturaVenta {
  id               String                @id @default(cuid())
  empresaId        String
  empresa          Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipoDocumentoId  String?
  tipoDocumento    TipoDocumento?        @relation(fields: [tipoDocumentoId], references: [id])
  numero           String // FEL-12345 (prefijo + consecutivo)
  consecutivoDIAN  Int?
  prefijo          String?
  // Datos del cliente (snapshot)
  terceroId        String?
  tercero          Tercero?              @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  nombreCliente    String
  nitCliente       String
  // Fechas
  fecha            DateTime              @default(now())
  fechaVencimiento DateTime?
  // Items
  detalles         DetalleFacturaVenta[]
  // Totales
  subtotalBruto    Float                 @default(0) // antes de descuentos
  descuentoTotal   Float                 @default(0)
  subtotalNeto     Float                 @default(0) // subtotal - descuento
  totalIva         Float                 @default(0)
  totalImpoconsumo Float                 @default(0)
  totalReteFuente  Float                 @default(0)
  totalReteICA     Float                 @default(0)
  totalReteIva     Float                 @default(0)
  total            Float                 @default(0)
  // DIAN
  cufe             String? // Código Único de Factura Electrónica (mock inicial)
  qrCode           String? // URL de representación DIAN
  xmlUBL           String? // UBL 2.1 string
  estadoDIAN       String                @default("borrador") // borrador | procesado | aceptado | rechazado
  // POS / forma de pago
  esPOS            Boolean               @default(false)
  cajeroId         String?
  formaPago        String? // efectivo | tarjeta | transferencia | credito | mixto
  efectivoRecibido Float?
  cambio           Float?
  // Cartera
  saldoPendiente   Float                 @default(0) // si formaPago=credito
  estadoCartera    String                @default("pagada") // pagada | parcial | pendiente | vencida
  // Estado
  estado           String                @default("vigente") // vigente | anulada
  observaciones    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
  @@index([empresaId, terceroId])
}

model DetalleFacturaVenta {
  id                  String       @id @default(cuid())
  facturaId           String
  factura             FacturaVenta @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  productoId          String?
  producto            Producto?    @relation(fields: [productoId], references: [id])
  descripcion         String
  cantidad            Float
  unidadMedida        String       @default("UND")
  precioUnitario      Float
  descuentoPorcentaje Float        @default(0)
  descuentoValor      Float        @default(0)
  subtotal            Float
  tarifaIva           Float        @default(19)
  iva                 Float        @default(0)
  impoconsumo         Float        @default(0)
  total               Float
  costoUnitario       Float        @default(0) // para utilidad
  bodegaId            String?
  loteId              String?

  @@index([facturaId])
}

// ---------- Compras y Proveedores (Hermes §5.4) ----------

model FacturaCompra {
  id                     String                 @id @default(cuid())
  empresaId              String
  empresa                Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero                 String // interno
  proveedorFacturaNumero String? // número del proveedor
  terceroId              String?
  tercero                Tercero?               @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  nombreProveedor        String
  nitProveedor           String
  fecha                  DateTime               @default(now())
  fechaVencimiento       DateTime?
  detalles               DetalleFacturaCompra[]
  subtotal               Float                  @default(0)
  descuentoTotal         Float                  @default(0)
  totalIva               Float                  @default(0) // IVA descontable
  totalImpoconsumo       Float                  @default(0)
  totalRetenciones       Float                  @default(0)
  total                  Float                  @default(0)
  saldoPendiente         Float                  @default(0)
  estadoCartera          String                 @default("pendiente")
  bodegaDestinoId        String?
  estado                 String                 @default("vigente") // vigente | anulada
  observaciones          String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model DetalleFacturaCompra {
  id              String        @id @default(cuid())
  facturaId       String
  factura         FacturaCompra @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  productoId      String?
  producto        Producto?     @relation(fields: [productoId], references: [id])
  descripcion     String
  cantidad        Float
  unidadMedida    String        @default("UND")
  precioUnitario  Float
  descuentoValor  Float         @default(0)
  subtotal        Float
  tarifaIva       Float         @default(19)
  iva             Float         @default(0)
  total           Float
  bodegaDestinoId String?

  @@index([facturaId])
}

// ---------- Cartera CXC / CXP (Hermes §5.9) ----------

model ReciboCaja {
  // Recibo de Caja / Comprobante de Ingreso (recaudo de cartera)
  id                 String   @id @default(cuid())
  empresaId          String
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero             String
  terceroId          String?
  tercero            Tercero? @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  nombreTercero      String
  fecha              DateTime @default(now())
  valorTotal         Float
  concepto           String?
  formaPago          String // efectivo | tarjeta | transferencia | cheque
  bancoId            String?
  observaciones      String?
  aplicacionFacturas String? // JSON [{facturaId, valor}]
  estado             String   @default("vigente")
  createdAt          DateTime @default(now())

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model ComprobanteEgreso {
  // Pago a proveedores y gastos
  id                String   @id @default(cuid())
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero            String
  terceroId         String?
  tercero           Tercero? @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  nombreTercero     String
  fecha             DateTime @default(now())
  valorTotal        Float
  concepto          String?
  formaPago         String // efectivo | transferencia | cheque
  bancoId           String?
  observaciones     String?
  aplicacionCompras String? // JSON [{facturaId, valor}]
  estado            String   @default("vigente")
  createdAt         DateTime @default(now())

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model Nota {
  // Notas débito y crédito (Hermes §5.9)
  id                String   @id @default(cuid())
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero            String
  tipo              String // debito | credito
  afecta            String // venta | compra
  facturaOrigenId   String?
  facturaOrigenTipo String? // Venta | Compra
  terceroId         String?
  tercero           Tercero? @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  fecha             DateTime @default(now())
  valorTotal        Float
  concepto          String?
  estado            String   @default("vigente")
  createdAt         DateTime @default(now())

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

// ---------- Contabilidad (Hermes §5.12) ----------

model CuentaPuc {
  id                  String               @id @default(cuid())
  empresaId           String
  empresa             Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo              String               @unique // 1105, 2205, 4175...
  nombre              String
  nivel               Int // 1 (clase) - 6 (auxiliar)
  naturaleza          String // debito | credito
  esAjustable         Boolean              @default(false) // para ajustes NIIF
  esMovimiento        Boolean              @default(true) // admite asientos
  saldoActual         Float                @default(0) // actualizado por comprobantes
  cuentaPadreId       String?
  cuentaPadre         CuentaPuc?           @relation("CuentaPucTree", fields: [cuentaPadreId], references: [id])
  subcuentas          CuentaPuc[]          @relation("CuentaPucTree")
  createdAt           DateTime             @default(now())
  movimientoContables MovimientoContable[]

  @@index([empresaId, codigo])
  @@index([cuentaPadreId])
}

model Comprobante {
  // Asiento contable (cabecera + movimientos)
  id                  String   @id @default(cuid())
  empresaId           String
  empresa             Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero              String // CG-2026-0001
  tipo                String // manual | facturacion | compra | nomina | cierre | ajuste | tesoreria
  fecha               DateTime @default(now())
  descripcion         String?
  totalDebito         Float    @default(0)
  totalCredito        Float    @default(0)
  diferencia          Float    @default(0) // debe ser 0 si está cuadrado
  estado              String   @default("borrador") // borrador | contabilizado | anulado
  documentoOrigenId   String?
  documentoOrigenTipo String?
  centroCostoId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  movimientos MovimientoContable[]

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model MovimientoContable {
  id            String      @id @default(cuid())
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  comprobanteId String
  comprobante   Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  cuentaId      String
  cuenta        CuentaPuc   @relation(fields: [cuentaId], references: [id])
  terceroId     String?
  tercero       Tercero?    @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  centroCostoId String?
  descripcion   String?
  debito        Float       @default(0)
  credito       Float       @default(0)
  fecha         DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([comprobanteId])
  @@index([empresaId, cuentaId, fecha])
  @@index([empresaId, terceroId, fecha])
}

// ============================================================
// MCP — Model Context Protocol (Anthropic open standard)
// Expone resources/tools/prompts del ERP a LLMs externos
// y consume servidores MCP externos (CRM-ALBRA, bancos, etc.)
// ============================================================

// Conexiones MCP externas (servidores MCP que el ERP consume)
model MCPConexion {
  id             String    @id @default(cuid())
  empresaId      String
  nombre         String // CRM-ALBRA, Banco BBVA, Shopify, etc.
  descripcion    String?
  tipoTransporte String    @default("sse") // sse | websocket | stdio (solo info)
  endpoint       String // URL del servidor MCP externo (http://... o wss://...)
  // Auth: token bearer o header custom (cifrado AES-256-GCM)
  authTokenEnc   String?
  authHeader     String    @default("Authorization")
  authPrefix     String    @default("Bearer")
  // Catálogos caché
  resources      String? // JSON array: [{ uri, name, description, mimeType }]
  tools          String? // JSON array: [{ name, description, inputSchema }]
  prompts        String? // JSON array: [{ name, description, arguments }]
  // Estado
  activo         Boolean   @default(true)
  ultimoSync     DateTime?
  ultimoError    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  logs MCPLog[]

  @@index([empresaId, activo])
}

// Log de todas las invocaciones MCP (auditoría)
model MCPLog {
  id         String       @id @default(cuid())
  empresaId  String
  conexionId String?
  conexion   MCPConexion? @relation(fields: [conexionId], references: [id], onDelete: SetNull)
  direccion  String // inbound (alguien llamó a nuestro server) | outbound (nosotros llamamos a externo)
  tipo       String // resource | tool | prompt
  nombre     String // uri de resource o name de tool/prompt
  argumentos String? // JSON input
  resultado  String? // JSON output (truncado si > 10KB)
  duracionMs Int?
  userId     String? // usuario que ejecutó (si fue autenticado)
  error      String?
  createdAt  DateTime     @default(now())

  @@index([empresaId, createdAt])
  @@index([conexionId, createdAt])
}

// ============================================================
// Módulo de Nómina y Nómina Electrónica DIAN (CUNE)
// Agregado por Task ERP-NOMINA
// Modelos: NominaConcepto, Nomina, DetalleNomina, RetencionFuenteTabla
// ============================================================

// Conceptos de nómina (devengos, deducciones, aportes, provisiones)
model NominaConcepto {
  id                    String   @id @default(cuid())
  empresaId             String
  codigo                String // SALARIO_BASICO, AUX_TRANSPORTE, EPS_TRABAJADOR, etc.
  nombre                String
  tipo                  String // devengo | deduccion | aporte_patronal | provision
  formula               String? // expresión: porcentaje, base (IBC), o fijo
  cuentaContableDebito  String? // codigo PUC
  cuentaContableCredito String?
  basePorDefecto        String   @default("salario") // salario | ibc | total_devengado
  porcentaje            Float    @default(0)
  activo                Boolean  @default(true)
  createdAt             DateTime @default(now())

  @@unique([empresaId, codigo])
  @@index([empresaId, tipo])
}

// Cabecera de liquidación de nómina
model Nomina {
  id                     String   @id @default(cuid())
  empresaId              String
  numero                 String // NOM-2026-0001
  tipo                   String   @default("quincenal") // quincenal | mensual | vacaciones | liquidacion_final
  periodoInicio          DateTime
  periodoFin             DateTime
  fechaPago              DateTime
  centroCostoId          String?
  estado                 String   @default("borrador") // borrador | causada | pagada | anulada
  // Totales
  totalDevengos          Float    @default(0)
  totalDeducciones       Float    @default(0)
  totalAportesPatronales Float    @default(0)
  totalProvisiones       Float    @default(0)
  netoAPagar             Float    @default(0)
  // Electrónica DIAN (CUNE)
  cune                   String? // Código Único de Nómina Electrónica (global)
  xmlUBL                 String? // XML global (no se usa por ahora, se genera por empleado)
  estadoDIAN             String   @default("borrador") // borrador | procesado | aceptado | rechazado
  comprobanteContableId  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  detalles DetalleNomina[]

  @@unique([empresaId, numero])
  @@index([empresaId, fechaPago])
}

// Detalle por empleado de la liquidación
model DetalleNomina {
  id                String   @id @default(cuid())
  nominaId          String
  nomina            Nomina   @relation(fields: [nominaId], references: [id], onDelete: Cascade)
  empresaId         String
  terceroId         String // empleado (Tercero tipo=empleado) — raw FK sin relation para no tocar schema Tercero
  // Bases
  salarioBasico     Float
  diasLaborados     Float    @default(30)
  ibc               Float    @default(0)
  // Devengos y deducciones como JSON
  devengos          String? // JSON array: [{ codigo, nombre, valor }]
  deducciones       String? // JSON array: [{ codigo, nombre, valor }]
  aportesPatronales String? // JSON
  provisiones       String? // JSON
  // Totales del empleado
  totalDevengado    Float    @default(0)
  totalDeducciones  Float    @default(0)
  netoAPagar        Float    @default(0)
  // Nómina electrónica específica
  cuneEmpleado      String? // CUNE individual (por empleado)
  xmlEmpleado       String?
  createdAt         DateTime @default(now())

  @@index([nominaId])
  @@index([empresaId, terceroId])
}

// Tabla de retención en la fuente por salarios (DIAN 2026)
model RetencionFuenteTabla {
  id         String   @id @default(cuid())
  empresaId  String
  vigencia   Int      @default(2026)
  desde      Float
  hasta      Float
  porcentaje Float
  baseUVT    Float
  activa     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([empresaId, vigencia])
}

// ---------- DIAN — Facturación Electrónica real ----------
// Configuración DIAN por empresa (certificado X.509 P12 cifrado con
// AES-256-GCM, datos del proveedor tecnológico autorizado, softwareId
// y softwarePin registrados en DIAN, ambiente pruebas/producción).
model ConfiguracionDIAN {
  id                           String    @id @default(cuid())
  empresaId                    String
  ambiente                     String    @default("pruebas") // pruebas | produccion
  certificadoP12Enc            String? // AES-256-GCM cifrado, base64 del .p12 cargado
  certificadoPasswordEnc       String? // AES-256-GCM cifrado
  certificadoSubject           String?
  certificadoValidFrom         DateTime?
  certificadoValidTo           DateTime?
  proveedorTecnologicoNit      String? // NIT del PAC (proveedor tecnológico autorizado)
  proveedorTecnologicoTokenEnc String? // token asignado por DIAN al PAC
  softwareId                   String? // identificador del software registrado en DIAN
  softwarePin                  String? // PIN del software
  webhookUrl                   String? // URL donde DIAN notifica cambios de estado
  activo                       Boolean   @default(false)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@unique([empresaId, ambiente])
  @@index([empresaId])
}

// Cola de envíos DIAN con reintentos automáticos (backoff exponencial).
model DIANEnvio {
  id             String    @id @default(cuid())
  empresaId      String
  facturaId      String?
  nominaId       String?
  tipoDocumento  String // factura_venta | nota_credito | nomina
  cufe           String
  trackId        String?
  estado         String    @default("pendiente") // pendiente | enviando | aceptado | rechazado | error
  intentos       Int       @default(0)
  maxIntentos    Int       @default(5)
  proximoIntento DateTime?
  respuestaDian  String? // JSON con la respuesta de DIAN
  mensajeError   String?
  xmlFirmado     String? // XML con firma XAdES-EPES
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([empresaId, estado])
  @@index([proximoIntento])
}

// ============================================================
// FASE 3 — Conciliación bancaria, Cajas POS, Créditos,
// Presupuesto, Verticales Restaurante/Hotel
// ============================================================

// ---------- Bancos y Conciliación (Hermes §5.8) ----------

model Banco {
  id              String           @id @default(cuid())
  empresaId       String
  codigo          String // 001=BanColombia, 002=BBVA, etc.
  nombre          String
  nit             String?
  contacto        String?
  telefono        String?
  email           String?
  activo          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  cuentaBancarias CuentaBancaria[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model CuentaBancaria {
  id                    String                 @id @default(cuid())
  empresaId             String
  bancoId               String
  banco                 Banco                  @relation(fields: [bancoId], references: [id], onDelete: Cascade)
  numeroCuenta          String
  tipo                  String                 @default("corriente") // ahorro | corriente
  titular               String
  saldoActual           Float                  @default(0)
  moneda                String                 @default("COP")
  activa                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  movimientoBancarios   MovimientoBancario[]
  extractoBancarios     ExtractoBancario[]
  conciliacionBancarias ConciliacionBancaria[]

  @@unique([empresaId, numeroCuenta])
  @@index([empresaId])
}

model MovimientoBancario {
  id               String         @id @default(cuid())
  empresaId        String
  cuentaBancariaId String
  cuentaBancaria   CuentaBancaria @relation(fields: [cuentaBancariaId], references: [id], onDelete: Cascade)
  fecha            DateTime       @default(now())
  tipo             String // deposito | retiro | transferencia | cheque | nota | interes | comision
  monto            Float // positivo: entrada, negativo: salida
  descripcion      String?
  terceroId        String?
  comprobanteId    String? // comprobante contable asociado
  conciliado       Boolean        @default(false)
  extractoId       String?
  createdAt        DateTime       @default(now())

  @@index([empresaId, fecha])
  @@index([cuentaBancariaId, conciliado])
}

model ExtractoBancario {
  id                    String                 @id @default(cuid())
  empresaId             String
  cuentaBancariaId      String
  cuentaBancaria        CuentaBancaria         @relation(fields: [cuentaBancariaId], references: [id], onDelete: Cascade)
  mes                   Int // 1-12
  anio                  Int
  saldoInicial          Float                  @default(0)
  saldoFinal            Float                  @default(0)
  archivo               String? // ruta o nombre del archivo MT940/CSV importado
  estado                String                 @default("pendiente") // pendiente | conciliado | parcial
  fechaConciliacion     DateTime?
  createdAt             DateTime               @default(now())
  extractoMovimientos   ExtractoMovimiento[]
  conciliacionBancarias ConciliacionBancaria[]

  @@unique([empresaId, cuentaBancariaId, mes, anio])
  @@index([empresaId])
}

model ExtractoMovimiento {
  id                   String           @id @default(cuid())
  empresaId            String
  extractoId           String
  extracto             ExtractoBancario @relation(fields: [extractoId], references: [id], onDelete: Cascade)
  fecha                DateTime
  descripcion          String
  monto                Float
  conciliado           Boolean          @default(false)
  movimientoBancarioId String? // si matchea con un movimiento interno
  createdAt            DateTime         @default(now())

  @@index([extractoId, conciliado])
}

model ConciliacionBancaria {
  id                   String            @id @default(cuid())
  empresaId            String
  cuentaBancariaId     String
  cuentaBancaria       CuentaBancaria    @relation(fields: [cuentaBancariaId], references: [id])
  extractoId           String?
  extracto             ExtractoBancario? @relation(fields: [extractoId], references: [id])
  fecha                DateTime          @default(now())
  saldoInicialLibro    Float             @default(0)
  saldoInicialExtracto Float             @default(0)
  ajustesLibro         Float             @default(0)
  ajustesExtracto      Float             @default(0)
  saldoFinalLibro      Float             @default(0)
  saldoFinalExtracto   Float             @default(0)
  diferencia           Float             @default(0)
  estado               String            @default("borrador") // borrador | conciliada | anulada
  userId               String?
  observaciones        String?
  createdAt            DateTime          @default(now())

  @@index([empresaId, fecha])
}

// ---------- Cajas POS y Arqueos (Hermes §5.8) ----------

model CajaPOS {
  id            String       @id @default(cuid())
  empresaId     String
  codigo        String
  nombre        String
  ubicacion     String? // Mostrador, Salon 1, etc.
  responsableId String?
  saldoInicial  Float        @default(0)
  saldoActual   Float        @default(0)
  estado        String       @default("abierta") // abierta | cerrada
  activa        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  arqueoCajas   ArqueoCaja[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model ArqueoCaja {
  id                  String   @id @default(cuid())
  empresaId           String
  cajaId              String
  caja                CajaPOS  @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  fecha               DateTime @default(now())
  turno               String   @default("completo") // mañana | tarde | noche | completo
  saldoInicial        Float    @default(0)
  ventasEfectivo      Float    @default(0)
  ventasTarjeta       Float    @default(0)
  ventasTransferencia Float    @default(0)
  otrosIngresos       Float    @default(0)
  gastosMenores       Float    @default(0)
  saldoFinalSistema   Float    @default(0)
  saldoFinalConteo    Float    @default(0)
  diferencia          Float    @default(0)
  observaciones       String?
  userId              String?
  createdAt           DateTime @default(now())

  @@index([empresaId, fecha])
  @@index([cajaId, fecha])
}

// ---------- Créditos y Financiación (Hermes §5.10) ----------

model SolicitudCredito {
  id              String    @id @default(cuid())
  empresaId       String
  terceroId       String?
  montoSolicitado Float
  tasaInteres     Float // % efectivo anual
  plazoMeses      Int
  cuotaN          Int // número de cuotas
  destino         String?
  referencias     String? // JSON
  estado          String    @default("pendiente") // pendiente | aprobada | rechazada | anulada
  aprobadoPorId   String?
  fechaAprobacion DateTime?
  observaciones   String?
  createdAt       DateTime  @default(now())
  creditos        Credito[]

  @@index([empresaId, estado])
}

model Credito {
  id             String            @id @default(cuid())
  empresaId      String
  terceroId      String?
  tercero        Tercero?          @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  solicitudId    String?
  solicitud      SolicitudCredito? @relation(fields: [solicitudId], references: [id])
  montoPrincipal Float
  tasaInteres    Float // % EA
  plazoMeses     Int
  cuotaN         Int
  fechaInicio    DateTime
  fechaFin       DateTime?
  saldoCapital   Float             @default(0)
  estado         String            @default("vigente") // vigente | pagado | en_mora | anulado
  cuotas         CuotaCredito[]
  createdAt      DateTime          @default(now())

  @@index([empresaId, estado])
}

model CuotaCredito {
  id                  String    @id @default(cuid())
  creditoId           String
  credito             Credito   @relation(fields: [creditoId], references: [id], onDelete: Cascade)
  empresaId           String
  numero              Int // 1, 2, 3...
  fechaVencimiento    DateTime
  capital             Float
  interes             Float
  totalCuota          Float
  saldoCapital        Float // saldo capital restante después de esta cuota
  estado              String    @default("pendiente") // pendiente | pagada | en_mora
  fechaPago           DateTime?
  comprobanteEgresoId String?
  createdAt           DateTime  @default(now())

  @@index([creditoId, numero])
  @@index([empresaId, estado])
}

// ---------- Presupuesto (Hermes §5.13) ----------

model RubroPresupuestal {
  id                 String              @id @default(cuid())
  empresaId          String
  codigo             String
  nombre             String
  tipo               String // ingreso | gasto
  nivel              Int                 @default(1)
  cuentaPadreId      String?
  cuentaPadre        RubroPresupuestal?  @relation("RubroTree", fields: [cuentaPadreId], references: [id])
  children           RubroPresupuestal[] @relation("RubroTree")
  vigencia           Int                 @default(2026)
  apropiacionInicial Float               @default(0)
  createdAt          DateTime            @default(now())
  cdps               CDP[]

  @@unique([empresaId, codigo, vigencia])
  @@index([empresaId, vigencia])
}

model CDP {
  id            String            @id @default(cuid())
  empresaId     String
  numero        String // CDP-2026-0001
  fecha         DateTime          @default(now())
  rubroId       String
  rubro         RubroPresupuestal @relation(fields: [rubroId], references: [id])
  valor         Float
  concepto      String?
  terceroId     String?
  estado        String            @default("vigente") // vigente | anulado | comprometido
  saldo         Float             @default(0)
  observaciones String?
  createdAt     DateTime          @default(now())
  crps          CRP[]

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model CRP {
  id        String   @id @default(cuid())
  empresaId String
  numero    String // CRP-2026-0001
  cdpId     String
  cdp       CDP      @relation(fields: [cdpId], references: [id], onDelete: Cascade)
  fecha     DateTime @default(now())
  valor     Float
  concepto  String?
  terceroId String?
  estado    String   @default("vigente") // vigente | anulado | obligacion
  saldo     Float    @default(0)
  createdAt DateTime @default(now())

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model ModificacionPresupuestal {
  id             String   @id @default(cuid())
  empresaId      String
  numero         String // MP-2026-0001
  fecha          DateTime @default(now())
  tipo           String // adicion | traslado | reduccion
  rubroOrigenId  String?
  rubroDestinoId String?
  valor          Float
  motivo         String?
  cdpId          String?
  estado         String   @default("vigente")
  createdAt      DateTime @default(now())

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

// ---------- Restaurante (Hermes §5.14) ----------

model Mesa {
  id        String    @id @default(cuid())
  empresaId String
  codigo    String
  nombre    String
  capacidad Int       @default(4)
  ubicacion String? // Salon 1, Terraza, Barra...
  posicionX Int       @default(0) // para mapa visual
  posicionY Int       @default(0)
  estado    String    @default("disponible") // disponible | ocupada | reservada | inactiva
  createdAt DateTime  @default(now())
  comandas  Comanda[]

  @@unique([empresaId, codigo])
  @@index([empresaId, estado])
}

model Comanda {
  id            String           @id @default(cuid())
  empresaId     String
  mesaId        String
  mesa          Mesa             @relation(fields: [mesaId], references: [id])
  meseroId      String?
  estado        String           @default("abierta") // abierta | facturada | anulada | cerrada
  fechaApertura DateTime         @default(now())
  fechaCierre   DateTime?
  total         Float            @default(0)
  observaciones String?
  detalles      DetalleComanda[]
  createdAt     DateTime         @default(now())

  @@index([empresaId, estado])
  @@index([mesaId, estado])
}

model DetalleComanda {
  id             String    @id @default(cuid())
  comandaId      String
  comanda        Comanda   @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  empresaId      String
  productoId     String?
  descripcion    String
  cantidad       Float     @default(1)
  precioUnitario Float
  subtotal       Float
  observaciones  String? // sin sal, extra queso...
  estado         String    @default("solicitado") // solicitado | preparando | listo | servido | anulado
  horaSolicitud  DateTime  @default(now())
  horaListo      DateTime?
  createdAt      DateTime  @default(now())

  @@index([comandaId])
}

// ---------- Hotelería (Hermes §5.15) ----------

model Habitacion {
  id            String         @id @default(cuid())
  empresaId     String
  codigo        String
  numero        String
  tipo          String         @default("sencilla") // sencilla | doble | suite | matrimonial
  capacidad     Int            @default(2)
  precioBase    Float          @default(0)
  planta        Int            @default(1)
  estado        String         @default("disponible") // disponible | ocupada | sucia | mantenimiento
  createdAt     DateTime       @default(now())
  reservaHotels ReservaHotel[]

  @@unique([empresaId, codigo])
  @@index([empresaId, estado])
}

model ReservaHotel {
  id            String     @id @default(cuid())
  empresaId     String
  habitacionId  String
  habitacion    Habitacion @relation(fields: [habitacionId], references: [id])
  terceroId     String?
  fechaCheckin  DateTime
  fechaCheckout DateTime
  noches        Int
  tarifaNoche   Float
  tarifaTotal   Float
  estado        String     @default("confirmada") // confirmada | checkin | checkout | cancelada | no_show
  observaciones String?
  createdAt     DateTime   @default(now())

  @@index([empresaId, fechaCheckin])
  @@index([habitacionId, estado])
}
