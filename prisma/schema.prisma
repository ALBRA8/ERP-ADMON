// ============================================================
// MARSELLA ERP — Prisma Schema
// Núcleo contable-administrativo inspirado en SG Hermes 9.2.1.1,
// rediseñado sobre Next.js 16 + TypeScript + SQLite (intercambiable
// a PostgreSQL cambiando el provider). Multi-tenant por Empresa,
// audit-hardened, con FK formales (deuda técnica de Hermes resuelta).
// Mapeo Hermes → Marsella documentado en docs/MIGRATION_FROM_HERMES.md
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Multi-tenancy: Empresa ----------

model Empresa {
  id                 String   @id @default(cuid())
  nit                String   @unique // 900.123.456-7
  razonSocial        String
  nombreComercial    String?
  direccion          String?
  telefono           String?
  ciudad             String?
  email              String?
  website            String?
  representanteLegal String?
  regimenTributario  String   @default("comun") // simple | comun | gran_contribuyente
  responsabilidad    String   @default("iva") // iva | no_responsable
  logo               String? // URL/base64
  moneda             String   @default("COP")
  decimales          Int      @default(2)
  redondeo           String   @default("half_up") // half_up | half_even | down
  zonaHoraria        String   @default("America/Bogota")
  // PUC maestro
  planCuentas        String   @default("Colombia_PUC")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  resolucionDian        ResolucionDian[]
  terceros              Tercero[]
  productos             Producto[]
  servicios             Servicio[]
  bodegas               Bodega[]
  unidadesMedida        UnidadMedida[]
  lineas                LineaClasificacion[]
  listasPrecio          ListaPrecio[]
  impuestos             Impuesto[]
  centrosCosto          CentroCosto[]
  cuentasPuc            CuentaPuc[]
  comprobantes          Comprobante[] // asientos contables
  movimientosCont       MovimientoContable[]
  facturasVenta         FacturaVenta[]
  facturasCompra        FacturaCompra[]
  recibosCaja           ReciboCaja[]
  comprobantesEgreso    ComprobanteEgreso[]
  notas                 Nota[]
  usuarios              Usuario[]
  parametros            Parametro[]
  tiposDocumento        TipoDocumento[]
  ciudades              Ciudad[]
  actividadesEconomicas ActividadEconomica[]
  planSuscripcion       PlanSuscripcion?
  auditoriaMultiTenant  AuditoriaMultiTenant[]
  cierresPeriodo        CierrePeriodo[]
}

// ---------- Seguridad / RBAC (Hermes §5.1 mejorado) ----------

model Usuario {
  id            String    @id @default(cuid())
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  email         String    @unique
  nombre        String
  passwordHash  String // bcryptjs
  rol           String    @default("vendedor") // admin | contador | cajero | vendedor | bodeguero
  activo        Boolean   @default(true)
  telefono      String?
  cargo         String?
  ultimoLogin   DateTime?
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([empresaId])
}

model Parametro {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clave       String
  valor       String // JSON scalar
  descripcion String?
  updatedAt   DateTime @updatedAt

  @@unique([empresaId, clave])
  @@index([empresaId])
}

// ---------- Catálogos maestros (Hermes §5.2) ----------

model Ciudad {
  id           String    @id @default(cuid())
  empresaId    String
  empresa      Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigoDane   String    @unique
  nombre       String
  departamento String
  createdAt    DateTime  @default(now())
  terceros     Tercero[]

  @@index([empresaId])
}

model ActividadEconomica {
  id          String    @id @default(cuid())
  empresaId   String
  empresa     Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigoCIIU  String
  descripcion String
  tarifaICA   Float     @default(0) // por mil
  createdAt   DateTime  @default(now())
  terceros    Tercero[]

  @@unique([empresaId, codigoCIIU])
}

model TipoDocumento {
  id                   String         @id @default(cuid())
  empresaId            String
  empresa              Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo               String // FAC | FPOS | COM | RC | CE | NDV | NCV | NDC | NCC
  nombre               String // Factura de Venta, Factura POS, Compra...
  naturaleza           String // debito | credito (para tercero y contable)
  afectaCartera        String         @default("none") // cxc | cxp | none
  afectaInventario     String         @default("none") // entrada | salida | none
  afectaContabilidad   Boolean        @default(true)
  consecutivoSiguiente Int            @default(1)
  createdAt            DateTime       @default(now())
  facturaVentas        FacturaVenta[]

  @@unique([empresaId, codigo])
}

// Resolución DIAN (Hermes §5.3) — soporta facturación electrónica
model ResolucionDian {
  id                   String   @id @default(cuid())
  empresaId            String
  empresa              Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numeroResolucion     String
  fechaResolucion      DateTime
  fechaInicioVigencia  DateTime
  fechaFinVigencia     DateTime
  prefijo              String // FEL, FPOS, FEST
  rangoinicio          Int
  rangoFin             Int
  rangoinicioActual    Int
  rangoFinActual       Int
  consecutivoSiguiente Int      @default(1) // # próximo
  tipoOperacion        String   @default("estandar") // estandar | pos | exportacion | no_dian
  ambiente             String   @default("produccion") // pruebas | produccion
  activa               Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@index([empresaId, activa])
}

model Impuesto {
  id               String     @id @default(cuid())
  empresaId        String
  empresa          Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo           String // 01 | 04 | 06 | 07 (DIAN)
  nombre           String // IVA 19% | IVA 5% | Excento | Impoconsumo
  tipo             String // iva | impoconsumo | retefuente | reteica | reteiva
  tarifa           Float // 19, 5, 0, 2.5, etc
  cuentaContableId String?
  activo           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  productos        Producto[]

  @@unique([empresaId, codigo])
}

model CentroCosto {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo    String
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([empresaId, codigo])
}

model UnidadMedida {
  id        String     @id @default(cuid())
  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo    String     @unique // UND, KG, LT, MTR, CJA
  nombre    String
  factor    Float      @default(1) // para conversions
  createdAt DateTime   @default(now())
  productos Producto[]

  @@index([empresaId])
}

// Clasificación 6 niveles (Hermes §5.2 - linea1..linea6 colapsado a árbol)
model LineaClasificacion {
  id        String               @id @default(cuid())
  empresaId String
  empresa   Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    LineaClasificacion?  @relation("LineaTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  LineaClasificacion[] @relation("LineaTree")
  nivel     Int // 1..6
  codigo    String
  nombre    String
  createdAt DateTime             @default(now())
  productos Producto[]

  @@unique([empresaId, codigo, nivel])
  @@index([empresaId, parentId])
}

model ListaPrecio {
  id              String           @id @default(cuid())
  empresaId       String
  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre          String // Mayorista, Detal, VIP
  margen          Float            @default(0) // % sobre costo
  activa          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  precioProductos PrecioProducto[]

  @@index([empresaId])
}

// ---------- Terceros (Hermes §5.2) ----------

model Tercero {
  id                   String              @id @default(cuid())
  empresaId            String
  empresa              Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo                 String // cliente | proveedor | empleado | socio | todos
  tipoDocumento        String              @default("CC") // CC | NIT | CE | TI | PT
  numeroDocumento      String
  digitoVerif          String?
  nombre               String // razón social o nombre completo
  apellido1            String?
  apellido2            String?
  nombreComercial      String?
  direccion            String?
  telefono             String?
  email                String?
  ciudadId             String?
  ciudad               Ciudad?             @relation(fields: [ciudadId], references: [id])
  departamento         String?
  pais                 String              @default("CO")
  regimenTributario    String              @default("comun")
  responsabilidad      String              @default("iva")
  actividadEconomicaId String?
  actividadEconomica   ActividadEconomica? @relation(fields: [actividadEconomicaId], references: [id])
  // Crédito
  cupoCredito          Float               @default(0)
  saldoCartera         Float               @default(0) // actualizado por triggers de factura/recibo
  diasPlazo            Int                 @default(0)
  // Empleado
  cargo                String?
  salario              Float?
  fechaIngreso         DateTime?
  epsId                String?
  arl                  String?
  afpId                String?
  // Auditoría
  activo               Boolean             @default(true)
  observaciones        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // Relaciones
  facturasVenta      FacturaVenta[]
  facturasCompra     FacturaCompra[]
  recibosCaja        ReciboCaja[]
  comprobantesEgreso ComprobanteEgreso[]
  notas              Nota[]
  movimientosCont    MovimientoContable[]
  creditos           Credito[]

  @@unique([empresaId, tipoDocumento, numeroDocumento])
  @@index([empresaId, tipo])
  @@index([empresaId, numeroDocumento])
}

// ---------- Productos / Inventario (Hermes §5.2 + §5.6) ----------

model Producto {
  id             String              @id @default(cuid())
  empresaId      String
  empresa        Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo         String // SKU interno
  codigoBarras   String?
  nombre         String
  descripcion    String?
  tipo           String              @default("producto") // producto | servicio | kit | insumo
  inventariable  Boolean             @default(true)
  unidadMedidaId String?
  unidadMedida   UnidadMedida?       @relation(fields: [unidadMedidaId], references: [id])
  lineaId        String?
  linea          LineaClasificacion? @relation(fields: [lineaId], references: [id])
  // Costos y precios
  costoPromedio  Float               @default(0)
  ultimoCosto    Float               @default(0)
  precio1        Float               @default(0) // precio base
  precio2        Float               @default(0)
  precio3        Float               @default(0)
  // Impuestos
  impuestoId     String?
  impuesto       Impuesto?           @relation(fields: [impuestoId], references: [id])
  tarifaIva      Float               @default(19) // snapshot
  // Inventario
  stockMinimo    Float               @default(0)
  stockMaximo    Float               @default(0)
  manejaLotes    Boolean             @default(false)
  manejaSeriales Boolean             @default(false)
  activo         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  detallesVenta    DetalleFacturaVenta[]
  detallesCompra   DetalleFacturaCompra[]
  movimientosInv   MovimientoInventario[]
  saldosInventario SaldoInventario[]
  preciosPorLista  PrecioProducto[]
  loteInventarios  LoteInventario[]

  @@unique([empresaId, codigo])
  @@index([empresaId, codigoBarras])
}

model Servicio {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo      String
  nombre      String
  descripcion String?
  precio      Float    @default(0)
  tarifaIva   Float    @default(19)
  duracion    Int? // minutos
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([empresaId, codigo])
}

model PrecioProducto {
  id            String      @id @default(cuid())
  productoId    String
  producto      Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  listaPrecioId String
  listaPrecio   ListaPrecio @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)
  precio        Float
  updatedAt     DateTime    @updatedAt

  @@unique([productoId, listaPrecioId])
}

// ---------- Bodegas e Inventario ----------

model Bodega {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo        String
  nombre        String
  direccion     String?
  responsableId String?
  activa        Boolean  @default(true)
  createdAt     DateTime @default(now())

  saldosInventario SaldoInventario[]
  movimientosInv   MovimientoInventario[]

  @@unique([empresaId, codigo])
}

// Saldo consolidado por bodega + producto
model SaldoInventario {
  id            String   @id @default(cuid())
  empresaId     String
  productoId    String
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  bodegaId      String
  bodega        Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  cantidad      Float    @default(0)
  costoTotal    Decimal  @default(0) // A-CRIT-002: dinero → Decimal
  costoPromedio Decimal  @default(0) // = costoTotal / cantidad
  stockMinimo   Float    @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([productoId, bodegaId])
  @@index([bodegaId])
}

// Lotes y seriales (Hermes §5.6)
model LoteInventario {
  id               String    @id @default(cuid())
  empresaId        String
  productoId       String
  producto         Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  bodegaId         String
  codigoLote       String
  fechaFabricacion DateTime?
  fechaVencimiento DateTime?
  cantidad         Float     @default(0)
  createdAt        DateTime  @default(now())

  @@unique([empresaId, productoId, codigoLote])
}

// Kardex (movimientos de inventario valorizados)
model MovimientoInventario {
  id            String   @id @default(cuid())
  empresaId     String
  productoId    String
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  bodegaId      String
  bodega        Bodega   @relation(fields: [bodegaId], references: [id])
  tipo          String // entrada | salida | traslado | ajuste
  cantidad      Float // + entrada, - salida
  costoUnitario Decimal // A-CRIT-002: dinero → Decimal
  costoTotal    Decimal // A-CRIT-002: dinero → Decimal
  documentoTipo String? // FAC_VENTA, COMPRA, AJUSTE...
  documentoId   String?
  loteId        String?
  fecha         DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([productoId, bodegaId, fecha])
  @@index([empresaId, fecha])
}

// ---------- Facturación de Venta (Hermes §5.3 mejorado) ----------

model FacturaVenta {
  id               String                @id @default(cuid())
  empresaId        String
  empresa          Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipoDocumentoId  String?
  tipoDocumento    TipoDocumento?        @relation(fields: [tipoDocumentoId], references: [id])
  numero           String // FEL-12345 (prefijo + consecutivo)
  consecutivoDIAN  Int?
  prefijo          String?
  // Datos del cliente (snapshot)
  terceroId        String?
  tercero          Tercero?              @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  nombreCliente    String
  nitCliente       String
  // Fechas
  fecha            DateTime              @default(now())
  fechaVencimiento DateTime?
  // Items
  detalles         DetalleFacturaVenta[]
  // Totales — A-CRIT-002: dinero → Decimal
  subtotalBruto    Decimal               @default(0) // antes de descuentos
  descuentoTotal   Decimal               @default(0)
  subtotalNeto     Decimal               @default(0) // subtotal - descuento
  totalIva         Decimal               @default(0)
  totalImpoconsumo Decimal               @default(0)
  totalReteFuente  Decimal               @default(0)
  totalReteICA     Decimal               @default(0)
  totalReteIva     Decimal               @default(0)
  total            Decimal               @default(0)
  // DIAN
  cufe             String? // Código Único de Factura Electrónica (mock inicial)
  qrCode           String? // URL de representación DIAN
  xmlUBL           String? // UBL 2.1 string
  estadoDIAN       String                @default("borrador") // borrador | procesado | aceptado | rechazado
  // POS / forma de pago
  esPOS            Boolean               @default(false)
  cajeroId         String?
  formaPago        String? // efectivo | tarjeta | transferencia | credito | mixto
  efectivoRecibido Decimal?
  cambio           Decimal?
  // Cartera
  saldoPendiente   Decimal               @default(0) // si formaPago=credito
  estadoCartera    String                @default("pagada") // pagada | parcial | pendiente | vencida
  // Estado
  estado           String                @default("vigente") // vigente | anulada
  observaciones    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
  @@index([empresaId, terceroId])
}

model DetalleFacturaVenta {
  id                  String       @id @default(cuid())
  facturaId           String
  factura             FacturaVenta @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  productoId          String?
  producto            Producto?    @relation(fields: [productoId], references: [id])
  descripcion         String
  cantidad            Float
  unidadMedida        String       @default("UND")
  precioUnitario      Decimal // A-CRIT-002: dinero → Decimal
  descuentoPorcentaje Float        @default(0)
  descuentoValor      Decimal      @default(0) // A-CRIT-002: dinero → Decimal
  subtotal            Decimal // A-CRIT-002: dinero → Decimal
  tarifaIva           Float        @default(19)
  iva                 Decimal      @default(0) // A-CRIT-002: dinero → Decimal
  impoconsumo         Decimal      @default(0) // A-CRIT-002: dinero → Decimal
  total               Decimal // A-CRIT-002: dinero → Decimal
  costoUnitario       Decimal      @default(0) // A-CRIT-002: dinero → Decimal — para utilidad
  bodegaId            String?
  loteId              String?

  @@index([facturaId])
}

// ---------- Compras y Proveedores (Hermes §5.4) ----------

model FacturaCompra {
  id                     String                 @id @default(cuid())
  empresaId              String
  empresa                Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero                 String // interno
  proveedorFacturaNumero String? // número del proveedor
  terceroId              String?
  tercero                Tercero?               @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  nombreProveedor        String
  nitProveedor           String
  fecha                  DateTime               @default(now())
  fechaVencimiento       DateTime?
  detalles               DetalleFacturaCompra[]
  subtotal               Decimal                @default(0) // A-CRIT-002: dinero → Decimal
  descuentoTotal         Decimal                @default(0) // A-CRIT-002: dinero → Decimal
  totalIva               Decimal                @default(0) // A-CRIT-002: dinero → Decimal — IVA descontable
  totalImpoconsumo       Decimal                @default(0) // A-CRIT-002: dinero → Decimal
  totalRetenciones       Decimal                @default(0) // A-CRIT-002: dinero → Decimal
  total                  Decimal                @default(0) // A-CRIT-002: dinero → Decimal
  saldoPendiente         Decimal                @default(0) // A-CRIT-002: dinero → Decimal
  estadoCartera          String                 @default("pendiente")
  bodegaDestinoId        String?
  estado                 String                 @default("vigente") // vigente | anulada
  observaciones          String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model DetalleFacturaCompra {
  id              String        @id @default(cuid())
  facturaId       String
  factura         FacturaCompra @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  productoId      String?
  producto        Producto?     @relation(fields: [productoId], references: [id])
  descripcion     String
  cantidad        Float
  unidadMedida    String        @default("UND")
  precioUnitario  Decimal // A-CRIT-002: dinero → Decimal
  descuentoValor  Decimal       @default(0) // A-CRIT-002: dinero → Decimal
  subtotal        Decimal // A-CRIT-002: dinero → Decimal
  tarifaIva       Float         @default(19)
  iva             Decimal       @default(0) // A-CRIT-002: dinero → Decimal
  total           Decimal // A-CRIT-002: dinero → Decimal
  bodegaDestinoId String?

  @@index([facturaId])
}

// ---------- Cartera CXC / CXP (Hermes §5.9) ----------

model ReciboCaja {
  // Recibo de Caja / Comprobante de Ingreso (recaudo de cartera)
  id                 String   @id @default(cuid())
  empresaId          String
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero             String
  terceroId          String?
  tercero            Tercero? @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  nombreTercero      String
  fecha              DateTime @default(now())
  valorTotal         Decimal // A-CRIT-002: dinero → Decimal
  concepto           String?
  formaPago          String // efectivo | tarjeta | transferencia | cheque
  bancoId            String?
  observaciones      String?
  aplicacionFacturas String? // JSON [{facturaId, valor}]
  estado             String   @default("vigente")
  createdAt          DateTime @default(now())

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model ComprobanteEgreso {
  // Pago a proveedores y gastos
  id                String   @id @default(cuid())
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero            String
  terceroId         String?
  tercero           Tercero? @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  nombreTercero     String
  fecha             DateTime @default(now())
  valorTotal        Decimal // A-CRIT-002: dinero → Decimal
  concepto          String?
  formaPago         String // efectivo | transferencia | cheque
  bancoId           String?
  observaciones     String?
  aplicacionCompras String? // JSON [{facturaId, valor}]
  estado            String   @default("vigente")
  createdAt         DateTime @default(now())

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model Nota {
  // Notas débito y crédito (Hermes §5.9)
  id                String   @id @default(cuid())
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero            String
  tipo              String // debito | credito
  afecta            String // venta | compra
  facturaOrigenId   String?
  facturaOrigenTipo String? // Venta | Compra
  terceroId         String?
  tercero           Tercero? @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  fecha             DateTime @default(now())
  valorTotal        Float
  concepto          String?
  estado            String   @default("vigente")
  createdAt         DateTime @default(now())

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

// ---------- Contabilidad (Hermes §5.12) ----------

model CuentaPuc {
  id                  String               @id @default(cuid())
  empresaId           String
  empresa             Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo              String               @unique // 1105, 2205, 4175...
  nombre              String
  nivel               Int // 1 (clase) - 6 (auxiliar)
  naturaleza          String // debito | credito
  esAjustable         Boolean              @default(false) // para ajustes NIIF
  esMovimiento        Boolean              @default(true) // admite asientos
  saldoActual         Float                @default(0) // actualizado por comprobantes
  cuentaPadreId       String?
  cuentaPadre         CuentaPuc?           @relation("CuentaPucTree", fields: [cuentaPadreId], references: [id])
  subcuentas          CuentaPuc[]          @relation("CuentaPucTree")
  createdAt           DateTime             @default(now())
  movimientoContables MovimientoContable[]

  @@index([empresaId, codigo])
  @@index([cuentaPadreId])
}

model Comprobante {
  // Asiento contable (cabecera + movimientos)
  id                  String   @id @default(cuid())
  empresaId           String
  empresa             Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero              String // CG-2026-0001
  tipo                String // manual | facturacion | compra | nomina | cierre | ajuste | tesoreria
  fecha               DateTime @default(now())
  descripcion         String?
  totalDebito         Float    @default(0)
  totalCredito        Float    @default(0)
  diferencia          Float    @default(0) // debe ser 0 si está cuadrado
  estado              String   @default("borrador") // borrador | contabilizado | anulado
  documentoOrigenId   String?
  documentoOrigenTipo String?
  centroCostoId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  movimientos MovimientoContable[]

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model MovimientoContable {
  id            String      @id @default(cuid())
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  comprobanteId String
  comprobante   Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  cuentaId      String
  cuenta        CuentaPuc   @relation(fields: [cuentaId], references: [id])
  terceroId     String?
  tercero       Tercero?    @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  centroCostoId String?
  descripcion   String?
  debito        Decimal     @default(0) // A-CRIT-002: dinero → Decimal
  credito       Decimal     @default(0) // A-CRIT-002: dinero → Decimal
  fecha         DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([comprobanteId])
  @@index([empresaId, cuentaId, fecha])
  @@index([empresaId, terceroId, fecha])
}

// ============================================================
// MCP — Model Context Protocol (Anthropic open standard)
// Expone resources/tools/prompts del ERP a LLMs externos
// y consume servidores MCP externos (CRM-ALBRA, bancos, etc.)
// ============================================================

// Conexiones MCP externas (servidores MCP que el ERP consume)
model MCPConexion {
  id             String    @id @default(cuid())
  empresaId      String
  nombre         String // CRM-ALBRA, Banco BBVA, Shopify, etc.
  descripcion    String?
  tipoTransporte String    @default("sse") // sse | websocket | stdio (solo info)
  endpoint       String // URL del servidor MCP externo (http://... o wss://...)
  // Auth: token bearer o header custom (cifrado AES-256-GCM)
  authTokenEnc   String?
  authHeader     String    @default("Authorization")
  authPrefix     String    @default("Bearer")
  // Catálogos caché
  resources      String? // JSON array: [{ uri, name, description, mimeType }]
  tools          String? // JSON array: [{ name, description, inputSchema }]
  prompts        String? // JSON array: [{ name, description, arguments }]
  // Estado
  activo         Boolean   @default(true)
  ultimoSync     DateTime?
  ultimoError    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  logs MCPLog[]

  @@index([empresaId, activo])
}

// Log de todas las invocaciones MCP (auditoría)
model MCPLog {
  id         String       @id @default(cuid())
  empresaId  String
  conexionId String?
  conexion   MCPConexion? @relation(fields: [conexionId], references: [id], onDelete: SetNull)
  direccion  String // inbound (alguien llamó a nuestro server) | outbound (nosotros llamamos a externo)
  tipo       String // resource | tool | prompt
  nombre     String // uri de resource o name de tool/prompt
  argumentos String? // JSON input
  resultado  String? // JSON output (truncado si > 10KB)
  duracionMs Int?
  userId     String? // usuario que ejecutó (si fue autenticado)
  error      String?
  createdAt  DateTime     @default(now())

  @@index([empresaId, createdAt])
  @@index([conexionId, createdAt])
}

// ============================================================
// Módulo de Nómina y Nómina Electrónica DIAN (CUNE)
// Agregado por Task ERP-NOMINA
// Modelos: NominaConcepto, Nomina, DetalleNomina, RetencionFuenteTabla
// ============================================================

// Conceptos de nómina (devengos, deducciones, aportes, provisiones)
model NominaConcepto {
  id                    String   @id @default(cuid())
  empresaId             String
  codigo                String // SALARIO_BASICO, AUX_TRANSPORTE, EPS_TRABAJADOR, etc.
  nombre                String
  tipo                  String // devengo | deduccion | aporte_patronal | provision
  formula               String? // expresión: porcentaje, base (IBC), o fijo
  cuentaContableDebito  String? // codigo PUC
  cuentaContableCredito String?
  basePorDefecto        String   @default("salario") // salario | ibc | total_devengado
  porcentaje            Float    @default(0)
  activo                Boolean  @default(true)
  createdAt             DateTime @default(now())

  @@unique([empresaId, codigo])
  @@index([empresaId, tipo])
}

// Cabecera de liquidación de nómina
model Nomina {
  id                     String   @id @default(cuid())
  empresaId              String
  numero                 String // NOM-2026-0001
  tipo                   String   @default("quincenal") // quincenal | mensual | vacaciones | liquidacion_final
  periodoInicio          DateTime
  periodoFin             DateTime
  fechaPago              DateTime
  centroCostoId          String?
  estado                 String   @default("borrador") // borrador | causada | pagada | anulada
  // Totales — A-CRIT-002: dinero → Decimal
  totalDevengos          Decimal  @default(0)
  totalDeducciones       Decimal  @default(0)
  totalAportesPatronales Decimal  @default(0)
  totalProvisiones       Decimal  @default(0)
  netoAPagar             Decimal  @default(0)
  // Electrónica DIAN (CUNE)
  cune                   String? // Código Único de Nómina Electrónica (global)
  xmlUBL                 String? // XML global (no se usa por ahora, se genera por empleado)
  estadoDIAN             String   @default("borrador") // borrador | procesado | aceptado | rechazado
  comprobanteContableId  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  detalles DetalleNomina[]

  @@unique([empresaId, numero])
  @@index([empresaId, fechaPago])
}

// Detalle por empleado de la liquidación
model DetalleNomina {
  id                String   @id @default(cuid())
  nominaId          String
  nomina            Nomina   @relation(fields: [nominaId], references: [id], onDelete: Cascade)
  empresaId         String
  terceroId         String // empleado (Tercero tipo=empleado) — raw FK sin relation para no tocar schema Tercero
  // Bases
  salarioBasico     Decimal // A-CRIT-002: dinero → Decimal
  diasLaborados     Float    @default(30)
  ibc               Decimal  @default(0) // A-CRIT-002: dinero → Decimal
  // Devengos y deducciones como JSON
  devengos          String? // JSON array: [{ codigo, nombre, valor }]
  deducciones       String? // JSON array: [{ codigo, nombre, valor }]
  aportesPatronales String? // JSON
  provisiones       String? // JSON
  // Totales del empleado — A-CRIT-002: dinero → Decimal
  totalDevengado    Decimal  @default(0)
  totalDeducciones  Decimal  @default(0)
  netoAPagar        Decimal  @default(0)
  // Nómina electrónica específica
  cuneEmpleado      String? // CUNE individual (por empleado)
  xmlEmpleado       String?
  createdAt         DateTime @default(now())

  @@index([nominaId])
  @@index([empresaId, terceroId])
}

// Tabla de retención en la fuente por salarios (DIAN 2026)
model RetencionFuenteTabla {
  id         String   @id @default(cuid())
  empresaId  String
  vigencia   Int      @default(2026)
  desde      Float
  hasta      Float
  porcentaje Float
  baseUVT    Float
  activa     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([empresaId, vigencia])
}

// ---------- DIAN — Facturación Electrónica real ----------
// Configuración DIAN por empresa (certificado X.509 P12 cifrado con
// AES-256-GCM, datos del proveedor tecnológico autorizado, softwareId
// y softwarePin registrados en DIAN, ambiente pruebas/producción).
model ConfiguracionDIAN {
  id                           String    @id @default(cuid())
  empresaId                    String
  ambiente                     String    @default("pruebas") // pruebas | produccion
  certificadoP12Enc            String? // AES-256-GCM cifrado, base64 del .p12 cargado
  certificadoPasswordEnc       String? // AES-256-GCM cifrado
  certificadoSubject           String?
  certificadoValidFrom         DateTime?
  certificadoValidTo           DateTime?
  proveedorTecnologicoNit      String? // NIT del PAC (proveedor tecnológico autorizado)
  proveedorTecnologicoTokenEnc String? // token asignado por DIAN al PAC
  softwareId                   String? // identificador del software registrado en DIAN
  softwarePin                  String? // PIN del software
  webhookUrl                   String? // URL donde DIAN notifica cambios de estado
  activo                       Boolean   @default(false)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@unique([empresaId, ambiente])
  @@index([empresaId])
}

// Cola de envíos DIAN con reintentos automáticos (backoff exponencial).
model DIANEnvio {
  id             String    @id @default(cuid())
  empresaId      String
  facturaId      String?
  nominaId       String?
  tipoDocumento  String // factura_venta | nota_credito | nomina
  cufe           String
  trackId        String?
  estado         String    @default("pendiente") // pendiente | enviando | aceptado | rechazado | error
  intentos       Int       @default(0)
  maxIntentos    Int       @default(5)
  proximoIntento DateTime?
  respuestaDian  String? // JSON con la respuesta de DIAN
  mensajeError   String?
  xmlFirmado     String? // XML con firma XAdES-EPES
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([empresaId, estado])
  @@index([proximoIntento])
}

// ============================================================
// FASE 3 — Conciliación bancaria, Cajas POS, Créditos,
// Presupuesto, Verticales Restaurante/Hotel
// ============================================================

// ---------- Bancos y Conciliación (Hermes §5.8) ----------

model Banco {
  id              String           @id @default(cuid())
  empresaId       String
  codigo          String // 001=BanColombia, 002=BBVA, etc.
  nombre          String
  nit             String?
  contacto        String?
  telefono        String?
  email           String?
  activo          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  cuentaBancarias CuentaBancaria[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model CuentaBancaria {
  id                    String                 @id @default(cuid())
  empresaId             String
  bancoId               String
  banco                 Banco                  @relation(fields: [bancoId], references: [id], onDelete: Cascade)
  numeroCuenta          String
  tipo                  String                 @default("corriente") // ahorro | corriente
  titular               String
  saldoActual           Decimal                @default(0) // A-CRIT-002: dinero → Decimal
  moneda                String                 @default("COP")
  activa                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  movimientoBancarios   MovimientoBancario[]
  extractoBancarios     ExtractoBancario[]
  conciliacionBancarias ConciliacionBancaria[]

  @@unique([empresaId, numeroCuenta])
  @@index([empresaId])
}

model MovimientoBancario {
  id               String         @id @default(cuid())
  empresaId        String
  cuentaBancariaId String
  cuentaBancaria   CuentaBancaria @relation(fields: [cuentaBancariaId], references: [id], onDelete: Cascade)
  fecha            DateTime       @default(now())
  tipo             String // deposito | retiro | transferencia | cheque | nota | interes | comision
  monto            Decimal // A-CRIT-002: dinero → Decimal — positivo: entrada, negativo: salida
  descripcion      String?
  terceroId        String?
  comprobanteId    String? // comprobante contable asociado
  conciliado       Boolean        @default(false)
  extractoId       String?
  createdAt        DateTime       @default(now())

  @@index([empresaId, fecha])
  @@index([cuentaBancariaId, conciliado])
}

model ExtractoBancario {
  id                    String                 @id @default(cuid())
  empresaId             String
  cuentaBancariaId      String
  cuentaBancaria        CuentaBancaria         @relation(fields: [cuentaBancariaId], references: [id], onDelete: Cascade)
  mes                   Int // 1-12
  anio                  Int
  saldoInicial          Float                  @default(0)
  saldoFinal            Float                  @default(0)
  archivo               String? // ruta o nombre del archivo MT940/CSV importado
  estado                String                 @default("pendiente") // pendiente | conciliado | parcial
  fechaConciliacion     DateTime?
  createdAt             DateTime               @default(now())
  extractoMovimientos   ExtractoMovimiento[]
  conciliacionBancarias ConciliacionBancaria[]

  @@unique([empresaId, cuentaBancariaId, mes, anio])
  @@index([empresaId])
}

model ExtractoMovimiento {
  id                   String           @id @default(cuid())
  empresaId            String
  extractoId           String
  extracto             ExtractoBancario @relation(fields: [extractoId], references: [id], onDelete: Cascade)
  fecha                DateTime
  descripcion          String
  monto                Float
  conciliado           Boolean          @default(false)
  movimientoBancarioId String? // si matchea con un movimiento interno
  createdAt            DateTime         @default(now())

  @@index([extractoId, conciliado])
}

model ConciliacionBancaria {
  id                   String            @id @default(cuid())
  empresaId            String
  cuentaBancariaId     String
  cuentaBancaria       CuentaBancaria    @relation(fields: [cuentaBancariaId], references: [id])
  extractoId           String?
  extracto             ExtractoBancario? @relation(fields: [extractoId], references: [id])
  fecha                DateTime          @default(now())
  saldoInicialLibro    Float             @default(0)
  saldoInicialExtracto Float             @default(0)
  ajustesLibro         Float             @default(0)
  ajustesExtracto      Float             @default(0)
  saldoFinalLibro      Float             @default(0)
  saldoFinalExtracto   Float             @default(0)
  diferencia           Float             @default(0)
  estado               String            @default("borrador") // borrador | conciliada | anulada
  userId               String?
  observaciones        String?
  createdAt            DateTime          @default(now())

  @@index([empresaId, fecha])
}

// ---------- Cajas POS y Arqueos (Hermes §5.8) ----------

model CajaPOS {
  id            String       @id @default(cuid())
  empresaId     String
  codigo        String
  nombre        String
  ubicacion     String? // Mostrador, Salon 1, etc.
  responsableId String?
  saldoInicial  Float        @default(0)
  saldoActual   Float        @default(0)
  estado        String       @default("abierta") // abierta | cerrada
  activa        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  arqueoCajas   ArqueoCaja[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model ArqueoCaja {
  id                  String   @id @default(cuid())
  empresaId           String
  cajaId              String
  caja                CajaPOS  @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  fecha               DateTime @default(now())
  turno               String   @default("completo") // mañana | tarde | noche | completo
  saldoInicial        Float    @default(0)
  ventasEfectivo      Float    @default(0)
  ventasTarjeta       Float    @default(0)
  ventasTransferencia Float    @default(0)
  otrosIngresos       Float    @default(0)
  gastosMenores       Float    @default(0)
  saldoFinalSistema   Float    @default(0)
  saldoFinalConteo    Float    @default(0)
  diferencia          Float    @default(0)
  observaciones       String?
  userId              String?
  createdAt           DateTime @default(now())

  @@index([empresaId, fecha])
  @@index([cajaId, fecha])
}

// ---------- Créditos y Financiación (Hermes §5.10) ----------

model SolicitudCredito {
  id              String    @id @default(cuid())
  empresaId       String
  terceroId       String?
  montoSolicitado Float
  tasaInteres     Float // % efectivo anual
  plazoMeses      Int
  cuotaN          Int // número de cuotas
  destino         String?
  referencias     String? // JSON
  estado          String    @default("pendiente") // pendiente | aprobada | rechazada | anulada
  aprobadoPorId   String?
  fechaAprobacion DateTime?
  observaciones   String?
  createdAt       DateTime  @default(now())
  creditos        Credito[]

  @@index([empresaId, estado])
}

model Credito {
  id             String            @id @default(cuid())
  empresaId      String
  terceroId      String?
  tercero        Tercero?          @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  solicitudId    String?
  solicitud      SolicitudCredito? @relation(fields: [solicitudId], references: [id])
  montoPrincipal Decimal // A-CRIT-002: dinero → Decimal
  tasaInteres    Float // % EA (tasa, no dinero — mantiene Float)
  plazoMeses     Int
  cuotaN         Int
  fechaInicio    DateTime
  fechaFin       DateTime?
  saldoCapital   Decimal           @default(0) // A-CRIT-002: dinero → Decimal
  estado         String            @default("vigente") // vigente | pagado | en_mora | anulado
  cuotas         CuotaCredito[]
  createdAt      DateTime          @default(now())

  @@index([empresaId, estado])
}

model CuotaCredito {
  id                  String    @id @default(cuid())
  creditoId           String
  credito             Credito   @relation(fields: [creditoId], references: [id], onDelete: Cascade)
  empresaId           String
  numero              Int // 1, 2, 3...
  fechaVencimiento    DateTime
  capital             Decimal // A-CRIT-002: dinero → Decimal
  interes             Decimal // A-CRIT-002: dinero → Decimal
  totalCuota          Decimal // A-CRIT-002: dinero → Decimal
  saldoCapital        Decimal // A-CRIT-002: dinero → Decimal — saldo capital restante después de esta cuota
  estado              String    @default("pendiente") // pendiente | pagada | en_mora
  fechaPago           DateTime?
  comprobanteEgresoId String?
  createdAt           DateTime  @default(now())

  @@index([creditoId, numero])
  @@index([empresaId, estado])
}

// ---------- Presupuesto (Hermes §5.13) ----------

model RubroPresupuestal {
  id                 String              @id @default(cuid())
  empresaId          String
  codigo             String
  nombre             String
  tipo               String // ingreso | gasto
  nivel              Int                 @default(1)
  cuentaPadreId      String?
  cuentaPadre        RubroPresupuestal?  @relation("RubroTree", fields: [cuentaPadreId], references: [id])
  children           RubroPresupuestal[] @relation("RubroTree")
  vigencia           Int                 @default(2026)
  apropiacionInicial Float               @default(0)
  createdAt          DateTime            @default(now())
  cdps               CDP[]
  modsOrigen         ModificacionPresupuestal[] @relation("ModifOrigen")
  modsDestino        ModificacionPresupuestal[] @relation("ModifDestino")

  @@unique([empresaId, codigo, vigencia])
  @@index([empresaId, vigencia])
}

model CDP {
  id            String            @id @default(cuid())
  empresaId     String
  numero        String // CDP-2026-0001
  fecha         DateTime          @default(now())
  rubroId       String
  rubro         RubroPresupuestal @relation(fields: [rubroId], references: [id])
  valor         Float
  concepto      String?
  terceroId     String?
  estado        String            @default("vigente") // vigente | anulado | comprometido
  saldo         Float             @default(0)
  observaciones String?
  createdAt     DateTime          @default(now())
  crps          CRP[]
  modificaciones ModificacionPresupuestal[]

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model CRP {
  id        String   @id @default(cuid())
  empresaId String
  numero    String // CRP-2026-0001
  cdpId     String
  cdp       CDP      @relation(fields: [cdpId], references: [id], onDelete: Cascade)
  fecha     DateTime @default(now())
  valor     Float
  concepto  String?
  terceroId String?
  estado    String   @default("vigente") // vigente | anulado | obligacion
  saldo     Float    @default(0)
  createdAt DateTime @default(now())

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model ModificacionPresupuestal {
  id             String   @id @default(cuid())
  empresaId      String
  numero         String // MP-2026-0001
  fecha          DateTime @default(now())
  tipo           String // adicion | traslado | reduccion
  rubroOrigenId  String?
  rubroOrigen    RubroPresupuestal? @relation("ModifOrigen", fields: [rubroOrigenId], references: [id])
  rubroDestinoId String?
  rubroDestino   RubroPresupuestal? @relation("ModifDestino", fields: [rubroDestinoId], references: [id])
  valor          Float
  motivo         String?
  cdpId          String?
  cdp            CDP?   @relation(fields: [cdpId], references: [id])
  estado         String   @default("vigente")
  createdAt      DateTime @default(now())

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

// ---------- Restaurante (Hermes §5.14) ----------

model Mesa {
  id        String    @id @default(cuid())
  empresaId String
  codigo    String
  nombre    String
  capacidad Int       @default(4)
  ubicacion String? // Salon 1, Terraza, Barra...
  posicionX Int       @default(0) // para mapa visual
  posicionY Int       @default(0)
  estado    String    @default("disponible") // disponible | ocupada | reservada | inactiva
  createdAt DateTime  @default(now())
  comandas  Comanda[]

  @@unique([empresaId, codigo])
  @@index([empresaId, estado])
}

model Comanda {
  id            String           @id @default(cuid())
  empresaId     String
  mesaId        String
  mesa          Mesa             @relation(fields: [mesaId], references: [id])
  meseroId      String?
  estado        String           @default("abierta") // abierta | facturada | anulada | cerrada
  fechaApertura DateTime         @default(now())
  fechaCierre   DateTime?
  total         Float            @default(0)
  observaciones String?
  detalles      DetalleComanda[]
  createdAt     DateTime         @default(now())

  @@index([empresaId, estado])
  @@index([mesaId, estado])
}

model DetalleComanda {
  id             String    @id @default(cuid())
  comandaId      String
  comanda        Comanda   @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  empresaId      String
  productoId     String?
  descripcion    String
  cantidad       Float     @default(1)
  precioUnitario Float
  subtotal       Float
  observaciones  String? // sin sal, extra queso...
  estado         String    @default("solicitado") // solicitado | preparando | listo | servido | anulado
  horaSolicitud  DateTime  @default(now())
  horaListo      DateTime?
  createdAt      DateTime  @default(now())

  @@index([comandaId])
}

// ---------- Hotelería (Hermes §5.15) ----------

model Habitacion {
  id            String         @id @default(cuid())
  empresaId     String
  codigo        String
  numero        String
  tipo          String         @default("sencilla") // sencilla | doble | suite | matrimonial
  capacidad     Int            @default(2)
  precioBase    Float          @default(0)
  planta        Int            @default(1)
  estado        String         @default("disponible") // disponible | ocupada | sucia | mantenimiento
  createdAt     DateTime       @default(now())
  reservaHotels ReservaHotel[]

  @@unique([empresaId, codigo])
  @@index([empresaId, estado])
}

model ReservaHotel {
  id            String     @id @default(cuid())
  empresaId     String
  habitacionId  String
  habitacion    Habitacion @relation(fields: [habitacionId], references: [id])
  terceroId     String?
  fechaCheckin  DateTime
  fechaCheckout DateTime
  noches        Int
  tarifaNoche   Float
  tarifaTotal   Float
  estado        String     @default("confirmada") // confirmada | checkin | checkout | cancelada | no_show
  observaciones String?
  createdAt     DateTime   @default(now())

  @@index([empresaId, fechaCheckin])
  @@index([habitacionId, estado])
}

// ============================================================
// FASE 4 — Verticales nicho + NIIF + Medios Magnéticos DIAN
// ============================================================

// ---------- Cafetero: Compra de café + Catación SCA (Hermes §5.16) ----------

model Finca {
  id            String       @id @default(cuid())
  empresaId     String
  nombre        String
  ubicacion     String?
  municipio     String?
  propietarioId String?
  hectareas     Float?
  altura        Int? // metros sobre el nivel del mar
  sombra        Boolean      @default(false)
  observaciones String?
  createdAt     DateTime     @default(now())
  compras       CompraCafe[]

  @@index([empresaId])
}

model CompraCafe {
  id                String              @id @default(cuid())
  empresaId         String
  numero            String // CAF-2026-0001
  terceroId         String?
  fincaId           String?
  finca             Finca?              @relation(fields: [fincaId], references: [id])
  fecha             DateTime            @default(now())
  // Pesaje físico
  pesoBruto         Float // kg brutos
  tara              Float               @default(0) // envases/sacos
  pesoNeto          Float // calculado
  factorRendimiento Float               @default(0) // % pasilla/defecto
  humedad           Float               @default(0) // %
  // Liquidación — A-CRIT-002: dinero → Decimal
  precioBaseKg      Decimal // precio por kg de café pergamino
  valorBruto        Decimal // pesoNeto * precioBaseKg
  descuentos        Decimal             @default(0) // humedad, broca, etc.
  retenciones       Decimal             @default(0) // retefuente 0.5%
  valorPagar        Decimal // valorBruto - descuentos - retenciones
  estado            String              @default("vigente") // vigente | liquidado | pagado | anulado
  observaciones     String?
  // Control de calidad (1-1)
  controlCalidad    ControlCalidadCafe?
  createdAt         DateTime            @default(now())

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
}

model ControlCalidadCafe {
  id              String     @id @default(cuid())
  empresaId       String
  compraCafeId    String     @unique
  compraCafe      CompraCafe @relation(fields: [compraCafeId], references: [id], onDelete: Cascade)
  fecha           DateTime   @default(now())
  // Análisis físico (almendra)
  almendraSana    Float      @default(0) // %
  broca           Float      @default(0) // %
  huecos          Float      @default(0) // %
  hongos          Float      @default(0) // %
  defectosTotales Float      @default(0) // %
  // Prueba de taza / catación (SCA 100 pts)
  catacionId      String?
  createdAt       DateTime   @default(now())
}

model PruebaTaza {
  id               String   @id @default(cuid())
  empresaId        String
  controlCalidadId String?
  fecha            DateTime @default(now())
  catador          String?
  // Atributos SCA (0-10 cada uno)
  fragranciaAroma  Float    @default(0)
  sabor            Float    @default(0)
  saborResidual    Float    @default(0)
  acidez           Float    @default(0)
  cuerpo           Float    @default(0)
  balance          Float    @default(0)
  uniformidad      Float    @default(0)
  tazaLimpia       Float    @default(0)
  dulzor           Float    @default(0)
  puntajeTotal     Float    @default(0) // suma
  observaciones    String?
  createdAt        DateTime @default(now())

  @@index([empresaId, fecha])
}

// ---------- Servicios Públicos: Lecturas masivas (Hermes §5.17) ----------

model UsuarioServicio {
  id              String           @id @default(cuid())
  empresaId       String
  terceroId       String?
  numeroContrato  String
  direccion       String
  estrato         Int              @default(1) // 1-6
  uso             String           @default("residencial") // residencial|comercial|industrial|oficial
  consumoPromedio Float            @default(0) // histórico
  tarifaFija      Float            @default(0) // cargo fijo
  tarifaVariable  Float            @default(0) // por unidad de consumo
  medidor         String? // # de medidor
  estado          String           @default("activo")
  createdAt       DateTime         @default(now())
  lecturaMedidors LecturaMedidor[]

  @@unique([empresaId, numeroContrato])
  @@index([empresaId])
}

model BloqueFacturacion {
  id        String   @id @default(cuid())
  empresaId String
  codigo    String
  nombre    String
  ciclo     Int // 1-12 (mensual, bimestral, etc.)
  diaCorte  Int // día del mes para corte
  diaPago   Int // día límite de pago
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([empresaId, codigo])
}

model LecturaMedidor {
  id                  String          @id @default(cuid())
  empresaId           String
  usuarioServicioId   String
  usuarioServicio     UsuarioServicio @relation(fields: [usuarioServicioId], references: [id], onDelete: Cascade)
  bloqueFacturacionId String?
  fechaLectura        DateTime        @default(now())
  lecturaAnterior     Float
  lecturaActual       Float
  consumo             Float // calculado = actual - anterior
  observaciones       String?
  facturada           Boolean         @default(false)
  facturaId           String?
  createdAt           DateTime        @default(now())

  @@index([empresaId, fechaLectura])
  @@index([usuarioServicioId])
}

model TarifaServicio {
  id           String   @id @default(cuid())
  empresaId    String
  tipoServicio String // agua|energia|gas|aseo
  estrato      Int
  uso          String
  rangoDesde   Float // m³ o kWh desde
  rangoHasta   Float // m³ o kWh hasta
  tarifa       Float // precio por unidad
  cargoFijo    Float    @default(0)
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([empresaId, tipoServicio])
}

// ---------- Taller / Servicio Técnico (Hermes §5.18) ----------

model OrdenServicioTecnico {
  id                      String                   @id @default(cuid())
  empresaId               String
  numero                  String // OST-2026-0001
  terceroId               String?
  fechaIngreso            DateTime                 @default(now())
  fechaEntrega            DateTime?
  estado                  String                   @default("ingresado") // ingresado|diagnostico|en_reparacion|listo|entregado|anulado
  // Equipo
  equipo                  String
  marca                   String?
  modelo                  String?
  serial                  String?
  // Problema y diagnóstico
  problemaReportado       String
  diagnostico             String?
  observaciones           String?
  tecnicoAsignadoId       String?
  valorRepuestos          Float                    @default(0)
  valorManoObra           Float                    @default(0)
  valorTotal              Float                    @default(0)
  facturaId               String?
  createdAt               DateTime                 @default(now())
  detalleServicioTecnicos DetalleServicioTecnico[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
  @@index([empresaId, fechaIngreso])
}

model DetalleServicioTecnico {
  id             String               @id @default(cuid())
  ordenId        String
  orden          OrdenServicioTecnico @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  empresaId      String
  tipo           String // repuesto|mano_obra|insumo
  descripcion    String
  cantidad       Float                @default(1)
  precioUnitario Float
  subtotal       Float
  createdAt      DateTime             @default(now())

  @@index([ordenId])
}

// ---------- Vehículos y Mascotas (Hermes §5.19) ----------

model Vehiculo {
  id            String   @id @default(cuid())
  empresaId     String
  terceroId     String?
  placa         String
  marca         String
  modelo        String
  anio          Int
  color         String?
  kilometraje   Int      @default(0)
  tipo          String   @default("particular") // particular|publico|carga|moto
  observaciones String?
  createdAt     DateTime @default(now())

  @@unique([empresaId, placa])
  @@index([empresaId])
}

model Mascota {
  id              String    @id @default(cuid())
  empresaId       String
  terceroId       String?
  nombre          String
  especie         String // perro|gato|ave|...
  raza            String?
  sexo            String? // M|H
  fechaNacimiento DateTime?
  color           String?
  microchip       String?
  observaciones   String?
  createdAt       DateTime  @default(now())

  @@index([empresaId])
}

// ---------- Medios Magnéticos DIAN ----------

model MedioMagnetico {
  id                     String                  @id @default(cuid())
  empresaId              String
  anio                   Int // vigencia fiscal (2026)
  formato                String // 1007|2276|2277|1647|2238
  nombre                 String // "Certificados de retención 2026"
  estado                 String                  @default("borrador") // borrador|generado|enviado
  fechaGeneracion        DateTime?
  archivo                String? // ruta del archivo .txt generado
  totalRegistros         Int                     @default(0)
  userId                 String?
  createdAt              DateTime                @default(now())
  medioMagneticoDetalles MedioMagneticoDetalle[]

  @@unique([empresaId, anio, formato])
  @@index([empresaId, anio])
}

model MedioMagneticoDetalle {
  id              String         @id @default(cuid())
  medioId         String
  medio           MedioMagnetico @relation(fields: [medioId], references: [id], onDelete: Cascade)
  // Estructura general tipo formato 1007
  tipoDocExpedida String? // CC|NIT|CE
  nitTercero      String
  razonSocial     String
  concepto        String // RETEFUENTE|RETEIVA|RETEICA
  valorPago       Float
  baseRetencion   Float          @default(0)
  porcentaje      Float          @default(0)
  valorRetenido   Float          @default(0)
  ciudad          String?
  createdAt       DateTime       @default(now())

  @@index([medioId])
}

// ---------- NIIF / IFRS ----------

model ReporteNIIF {
  id          String   @id @default(cuid())
  empresaId   String
  tipo        String // ESF|EER|ECP|EFE|Notas
  periodo     String // anual|trimestral
  fechaInicio DateTime
  fechaFin    DateTime
  json_data   String // JSON con el reporte completo estructurado
  archivo     String? // PDF generado
  userId      String?
  createdAt   DateTime @default(now())

  @@index([empresaId, tipo, fechaFin])
}

model CuentaNIIF {
  id          String   @id @default(cuid())
  empresaId   String
  codigoNIIF  String // código IFRS taxonomy
  nombre      String
  categoria   String // activo_corriente|activo_no_corriente|pasivo_corriente|pasivo_no_corriente|patrimonio|ingreso|gasto
  saldoActual Float    @default(0)
  cuentaPucId String? // mapeo al PUC colombiano
  createdAt   DateTime @default(now())

  @@unique([empresaId, codigoNIIF])
  @@index([empresaId, categoria])
}

// ---------- Multi-empresa SaaS: Plan + Auditoría multi-tenant ----------

model PlanSuscripcion {
  id                String    @id @default(cuid())
  empresaId         String    @unique
  empresa           Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  plan              String    @default("free") // free | basic | pro | enterprise
  modulos           String    @default("[]") // JSON array de módulos activos
  limiteUsuarios    Int       @default(5)
  limiteTerceros    Int       @default(100)
  limiteProductos   Int       @default(100)
  limiteFacturasMes Int       @default(100)
  vigenteHasta      DateTime?
  estado            String    @default("activo") // activo | suspendido | cancelado
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([empresaId])
}

model AuditoriaMultiTenant {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  userId    String?
  accion    String // login | crear_empresa | cambiar_plan | exportar | etc.
  entidad   String? // factura | tercero | etc.
  entityId  String?
  detalles  String? // JSON
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([empresaId, createdAt])
  @@index([userId, createdAt])
}

// ============================================================
// FASE 5 — Producción/Costos + DIAN Radian + Cierre Hermes §5.7 y §5.5
// ============================================================

// ---------- Costos / Órdenes de Producción (Hermes §5.7) ----------

model OrdenProduccion {
  id                    String                   @id @default(cuid())
  empresaId             String
  numero                String // PROD-2026-0001
  fechaInicio           DateTime                 @default(now())
  fechaFin              DateTime?
  estado                String                   @default("borrador") // borrador | en_proceso | finalizada | anulada
  productoResultanteId  String? // producto terminado a obtener
  cantidadProducir      Float
  cantidadProducida     Float                    @default(0)
  // Costos
  costoMateriaPrima     Float                    @default(0)
  costoManoObra         Float                    @default(0)
  costoIndirectos       Float                    @default(0)
  costoTotal            Float                    @default(0)
  costoUnitario         Float                    @default(0)
  // Comprobante contable
  comprobanteContableId String?
  observaciones         String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  detalles              DetalleOrdenProduccion[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
}

model DetalleOrdenProduccion {
  id            String          @id @default(cuid())
  ordenId       String
  orden         OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  empresaId     String
  tipo          String // materia_prima | mano_obra | costo_indirecto
  productoId    String? // si es materia prima
  descripcion   String
  cantidad      Float           @default(1)
  costoUnitario Float
  subtotal      Float
  createdAt     DateTime        @default(now())

  @@index([ordenId])
}

model RecetaProducto {
  id           String              @id @default(cuid())
  empresaId    String
  productoId   String?
  nombre       String
  descripcion  String?
  rendimiento  Float               @default(1) // 1 kg materia prima -> 0.85 kg producto terminado
  activa       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  ingredientes RecetaIngrediente[]

  @@index([empresaId, productoId])
}

model RecetaIngrediente {
  id            String         @id @default(cuid())
  recetaId      String
  receta        RecetaProducto @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  empresaId     String
  productoId    String? // materia prima
  descripcion   String
  cantidad      Float // cantidad por 1 unidad de producto terminado
  costoUnitario Float          @default(0)
  subtotal      Float          @default(0) // calculado: cantidad * costo
  createdAt     DateTime       @default(now())

  @@index([recetaId])
}

// ---------- DIAN Radian (Hermes §5.5) ----------

model EventoRadian {
  id              String   @id @default(cuid())
  empresaId       String
  numero          String // RAD-2026-0001
  facturaCompraId String? // factura electrónica recibida
  tipo            String // 030=acuse_recibo | 031=recibo_bien | 032=rechazo | 033=transferencia
  fecha           DateTime @default(now())
  terceroId       String?
  nitEmisor       String // NIT del proveedor
  cufeFactura     String // CUFE de la factura electrónica recibida
  // Respuesta DIAN
  estado          String   @default("borrador") // borrador | enviado | aceptado | rechazado
  xmlEvento       String? // XML UBL del evento
  respuestaDIAN   String? // JSON respuesta
  trackId         String?
  mensajeError    String?
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId, tipo])
  @@index([empresaId, estado])
}

// ---------- Cierre Contable (Hermes §5.12 — N-CRIT-008) ----------

model CierrePeriodo {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  anio          Int
  mes           Int // 1-12 (0 = cierre anual)
  tipo          String // mensual | anual
  estado        String   @default("cerrado") // cerrado | abierto
  fechaCierre   DateTime @default(now())
  userId        String?
  observaciones String?
  createdAt     DateTime @default(now())

  @@unique([empresaId, anio, mes])
  @@index([empresaId, anio])
}
