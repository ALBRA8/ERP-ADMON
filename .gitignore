# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*

# logs
*.log
dev.log
dev.out.log
server.log

# Skills directory (private)
/skills/

# Internal agent context (private)
/agent-ctx/

# Worklog (internal development log, may contain sensitive info)
worklog.md

# Audit reports (may contain PoCs of vulnerabilities)
/audit/

# Database files (SQLite with demo data — never commit)
/db/
*.db
*.db-journal

# Cloned reference repos (not part of this project)
/repo-crm-albra/
/repo-erp-admon/
/repo-compare/

# Tool results (private)
/tool-results/

# Upload directory (user files)
/upload/

# Download directory (generated artifacts)
/download/

# Mini services build artifacts
/mini-services/*/node_modules/
/mini-services/*/dist/

# PWA session data
.wa-auth/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
Thumbs.db

# Z.ai internal scripts
/.zscripts/

# Tool results (private)
/tool-results/

# Dev server PID
.zscripts/dev.pid
